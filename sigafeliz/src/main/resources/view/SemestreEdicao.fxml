<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.SemestreEdicaoController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <VBox spacing="10">
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="CONFIGURAÇÃO DE CALENDÁRIO ACADÊMICO" />
        <Separator />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label fx:id="lblSemestreSelecionado" style="-fx-font-weight: bold; -fx-font-size: 15px;" text="Semestre: --" />

        <HBox alignment="CENTER" spacing="15.0" HBox.hgrow="ALWAYS">
            <Button onAction="#mesAnterior" styleClass="btn-secondary" text="&lt;" />
            <Label fx:id="lblMesAno" alignment="CENTER" prefWidth="150.0" style="-fx-font-weight: bold; -fx-font-size: 16px;" text="JANEIRO 2025" />
            <Button onAction="#proximoMes" styleClass="btn-secondary" text="&gt;" />
        </HBox>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" alignment="CENTER" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <GridPane fx:id="gridCalendario" alignment="CENTER" hgap="0" vgap="0">
                <columnConstraints>
                    <ColumnConstraints minWidth="65.0" prefWidth="65.0" />
                    <ColumnConstraints minWidth="65.0" prefWidth="65.0" />
                    <ColumnConstraints minWidth="65.0" prefWidth="65.0" />
                    <ColumnConstraints minWidth="65.0" prefWidth="65.0" />
                    <ColumnConstraints minWidth="65.0" prefWidth="65.0" />
                    <ColumnConstraints minWidth="65.0" prefWidth="65.0" />
                    <ColumnConstraints minWidth="65.0" prefWidth="65.0" />
                </columnConstraints>
            </GridPane>
        </VBox>

        <VBox prefWidth="320.0" spacing="15.0" styleClass="card">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="LEGENDA" />

            <VBox spacing="12.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-min-width: 20; -fx-min-height: 20; -fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4;" />
                    <Label style="-fx-font-size: 13px;" text="Dia Letivo (Útil)" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-min-width: 20; -fx-min-height: 20; -fx-background-color: #f8d7da; -fx-border-color: #f5c6cb; -fx-border-radius: 4; -fx-background-radius: 4;" />
                    <Label style="-fx-font-size: 13px;" text="Feriado / Restrição" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-min-width: 20; -fx-min-height: 20; -fx-background-color: #cfe2f3; -fx-border-color: #9ac4e6; -fx-border-radius: 4; -fx-background-radius: 4;" />
                    <Label style="-fx-font-size: 13px;" text="Sábado Letivo" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-min-width: 20; -fx-min-height: 20; -fx-background-color: #d6d8db; -fx-border-color: #c6c8ca; -fx-border-radius: 4; -fx-background-radius: 4;" />
                    <Label style="-fx-font-size: 13px;" text="Fim de Semana" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-min-width: 20; -fx-min-height: 20; -fx-background-color: #e9ecef; -fx-border-color: #dee2e6; -fx-border-radius: 4; -fx-background-radius: 4;" />
                    <Label style="-fx-font-size: 13px;" text="Fora do Semestre" />
                </HBox>
            </VBox>

            <Separator />

            <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="INSTRUÇÕES:&#10;1. Use as setas para navegar entre os meses.&#10;2. Clique em dias úteis para definir feriados.&#10;3. Clique em sábados para torná-los letivos." wrapText="true" />

            <Region VBox.vgrow="ALWAYS" />

            <Separator />

            <VBox spacing="10.0">
                <Button maxWidth="Infinity" onAction="#handleSalvarVoltar" styleClass="btn-primary" text="Concluir Configuração" />
                <Button maxWidth="Infinity" onAction="#handleCancelar" styleClass="btn-secondary" text="Cancelar" />
            </VBox>
        </VBox>
    </HBox>
</VBox>