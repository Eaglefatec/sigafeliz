<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="15.0"
      style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3; -fx-border-style: solid;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sigafeliz.controller.ProfessoresListaController">

    <Label text="TELAS DE COORDENADOR: LISTA DE PROFESSORES" underline="true">
        <font>
            <Font name="Monospaced Bold" size="18.0" />
        </font>
    </Label>

    <TableView fx:id="tabelaProfessores" prefHeight="300.0" prefWidth="750.0" style="-fx-border-color: black; -fx-border-width: 2;">
        <columns>
            <TableColumn fx:id="colNome" prefWidth="300.0" text="Nome" />
            <TableColumn fx:id="colEmail" prefWidth="300.0" text="E-mail" />
            <TableColumn fx:id="colSelec" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Selec." />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER" spacing="10.0">
        <TextField fx:id="txtNome" prefWidth="300.0" promptText="Nome do Professor"
                   style="-fx-border-color: black; -fx-border-width: 2;"/>
        <TextField fx:id="txtEmail" prefWidth="300.0" promptText="E-mail"
                   style="-fx-border-color: black; -fx-border-width: 2;"/>
        <Button fx:id="btnSalvar" onAction="#salvarProfessor" prefHeight="40.0" prefWidth="100.0"
                style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 3;" text="Salvar">
            <font>
                <Font name="Monospaced Bold" size="14.0" />
            </font>
        </Button>
    </HBox>

    <HBox prefHeight="2.0" prefWidth="200.0" style="-fx-border-color: black; -fx-border-width: 2 0 0 0; -fx-border-style: dashed;">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </HBox>

    <HBox alignment="CENTER" spacing="450.0">
        <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltarParaHome"
                style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3;" text="← Voltar">
            <font>
                <Font name="Monospaced Bold" size="14.0" />
            </font>
        </Button>
        <Button fx:id="btnAvancar" mnemonicParsing="false" onAction="#irParaProximaTela"
                style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3;" text="Avançar →">
            <font>
                <Font name="Monospaced Bold" size="14.0" />
            </font>
        </Button>
        <padding>
            <Insets top="10.0" />
        </padding>
    </HBox>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>