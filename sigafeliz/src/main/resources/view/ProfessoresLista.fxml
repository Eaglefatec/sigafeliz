<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.ProfessoresListaController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <VBox spacing="10">
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="LISTA DE PROFESSORES" />
        <Separator />
    </VBox>

    <TableView fx:id="tabelaProfessores" prefHeight="250.0" styleClass="wireframe-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome" prefWidth="350.0" text="Nome" />
            <TableColumn fx:id="colEmail" prefWidth="350.0" text="E-mail" />
            <TableColumn fx:id="colSelec" prefWidth="100.0" text="Selec." style="-fx-alignment: CENTER;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <VBox styleClass="card" spacing="15.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>

        <HBox alignment="CENTER" spacing="15.0">
            <TextField fx:id="txtNome" promptText="Nome do Professor" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtEmail" promptText="E-mail" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER" spacing="20.0">
            <Button fx:id="btnSalvar" onAction="#salvarProfessor" prefHeight="40.0" prefWidth="120.0" styleClass="btn-primary" text="Salvar" />
            <Button fx:id="btnExcluir" onAction="#excluirProfessor" prefHeight="40.0" prefWidth="120.0" styleClass="btn-danger" text="Excluir" />
        </HBox>
    </VBox>

    <Separator />

    <HBox alignment="CENTER">
        <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltarParaHome" prefHeight="40.0" prefWidth="120.0" styleClass="btn-secondary" text="← Voltar" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnAvancar" mnemonicParsing="false" onAction="#irParaProximaTela" prefHeight="40.0" prefWidth="120.0" styleClass="btn-primary" text="Avançar →" />
    </HBox>

</VBox>