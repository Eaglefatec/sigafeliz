<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.SemestreListaController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label maxWidth="1.7976931348623157E308" style="-fx-border-color: transparent transparent black transparent; -fx-border-width: 0 0 2 0; -fx-padding: 0 0 5 0;" text="CADASTRO DE SEMESTRE">
        <font>
            <Font name="Monospaced Bold" size="18.0" />
        </font>
    </Label>

    <VBox spacing="15.0" style="-fx-border-color: black; -fx-border-width: 2; -fx-padding: 15;">
        <Label text="Input pra criar novo semestre">
            <font>
                <Font name="Monospaced Regular" size="14.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="15.0">

            <Label style="-fx-font-family: 'Monospaced';" text="Nome:" />
            <TextField fx:id="txtNome" prefWidth="120.0" promptText="Ex: 2025.1" style="-fx-border-color: black; -fx-border-width: 2; -fx-font-family: 'Monospaced';" />

            <Label style="-fx-font-family: 'Monospaced';" text="Início:" />
            <DatePicker fx:id="dpInicio" prefWidth="130.0" style="-fx-border-color: black; -fx-border-width: 2;" />

            <Label style="-fx-font-family: 'Monospaced';" text="Fim:" />
            <DatePicker fx:id="dpFim" prefWidth="130.0" style="-fx-border-color: black; -fx-border-width: 2;" />


        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <Label style="-fx-font-family: 'Monospaced';" text="Kickoff:" />
            <DatePicker fx:id="dpKickoff" prefWidth="130.0" style="-fx-border-color: black; -fx-border-width: 2;" />

            <Button onAction="#handleCriarSemestre" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3; -fx-font-family: 'Monospaced'; -fx-font-weight: bold; -fx-cursor: hand;" text="CRIAR NOVO SEMESTRE" />

        </HBox>
    </VBox>

    <Label text="Lista de semestres">
        <font>
            <Font name="Monospaced Bold" size="14.0" />
        </font>
    </Label>

    <TableView fx:id="tabelaSemestres" styleClass="wireframe-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colNome" text="Nome" />
            <TableColumn fx:id="colInicio" text="Início" />
            <TableColumn fx:id="colFim" text="Fim" />
            <TableColumn fx:id="colKickoff" text="Kickoff" />
            <TableColumn fx:id="colAcoes" maxWidth="120.0" minWidth="100.0" style="-fx-alignment: CENTER;" text="Ações" />
        </columns>
    </TableView>

    <HBox style="-fx-border-color: black transparent transparent transparent; -fx-border-width: 2 0 0 0; -fx-border-style: dashed; -fx-padding: 15 0 0 0;">
        <Button onAction="#handleVoltar" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3; -fx-font-family: 'Monospaced'; -fx-font-weight: bold; -fx-cursor: hand;" text="← Voltar" />
    </HBox>
</VBox>