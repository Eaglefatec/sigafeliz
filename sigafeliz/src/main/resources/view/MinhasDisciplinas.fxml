<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: white; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.MinhasDisciplinasController">
    <children>

        <!-- Caixa Principal do Wireframe -->
        <VBox prefWidth="850.0" style="-fx-border-color: black; -fx-border-width: 3; -fx-padding: 20; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, black, 0, 0, 5, 5);">
            <children>

                <!-- Título: MINHAS DISCIPLINAS -->
                <Label maxWidth="1.7976931348623157E308" style="-fx-border-color: transparent transparent black transparent; -fx-border-width: 0 0 3 0; -fx-padding: 0 0 5 0;" text="MINHAS DISCIPLINAS">
                    <font>
                        <Font name="Monospaced Bold" size="20.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <!-- Linha de Boas-vindas e Filtro de Semestre -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Bem-vindo, ">
                            <font>
                                <Font name="Monospaced Regular" size="14.0" />
                            </font>
                        </Label>
                        <!-- Adicionado o fx:id correto para o seu Controller injetar o nome do Professor -->
                        <Label fx:id="lblNomeProfessor" style="-fx-font-weight: bold;" text="...">
                            <font>
                                <Font name="Monospaced Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label text="| Selecione o Semestre letivo:">
                            <font>
                                <Font name="Monospaced Regular" size="14.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="15.0" />
                            </HBox.margin>
                        </Label>
                        <ComboBox fx:id="comboSemestre" prefWidth="150.0" promptText="2026.1" style="-fx-border-color: black; -fx-border-width: 2; -fx-background-color: white; -fx-font-family: 'Monospaced';" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </HBox>

                <!-- Tabela de Disciplinas Corrigida (Formatação padronizada em todas as colunas) -->
                <TableView fx:id="tabelaDisciplinas" prefHeight="200.0" style="-fx-border-color: black; -fx-border-width: 2; -fx-font-family: 'Monospaced';">
                    <columns>
                        <TableColumn fx:id="colNome" prefWidth="350.0" text="Disciplina" />
                        <TableColumn fx:id="colAulasSemana" prefWidth="200.0" text="Aulas/Semana" />
                        <TableColumn fx:id="colCarga" prefWidth="150.0" text="Carga Exigida" />
                        <!-- Coluna Selec. limpa e idêntica às demais (o alinhamento do rádio é feito dinamicamente pelo Controller) -->
                        <TableColumn fx:id="colSelec" prefWidth="104.0" text="Selec." />
                    </columns>
                    <VBox.margin>
                        <Insets bottom="25.0" />
                    </VBox.margin>
                </TableView>

                <!-- Botões de Navegação Inferiores com onAction configurados -->
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 15 0 0 0;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleVoltar" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2; -fx-cursor: hand;" text="← Voltar">
                            <font>
                                <Font name="Monospaced Bold" size="14.0" />
                            </font>
                        </Button>
                        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handlePlanejar" style="-fx-background-color: #eee; -fx-border-color: black; -fx-border-width: 3; -fx-cursor: hand;" text="Planejar Ementa →">
                                    <font>
                                        <Font name="Monospaced Bold" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </HBox>

            </children>
        </VBox>

    </children>
</VBox>