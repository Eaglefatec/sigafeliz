<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="15.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.MinhasDisciplinasController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <children>
        <Label text="MINHAS DISCIPLINAS">
            <font>
                <Font name="Monospaced Bold" size="20.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Bem-vindo, " />
                <Label fx:id="lblNomeProfessor" style="-fx-font-weight: bold;" text="Professor" />
                <Label style="-fx-padding: 0 0 0 20;" text="| Selecione o Semestre letivo:" />
                <ComboBox fx:id="comboSemestre" prefWidth="150.0" promptText="-- Semestre --" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2; -fx-font-family: 'Monospaced';" />
            </children>
        </HBox>

        <TableView fx:id="tabelaDisciplinas" styleClass="wireframe-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colNome" text="Disciplina" />
                <TableColumn fx:id="colAulasSemana" text="Aulas/Semana" />
                <TableColumn fx:id="colCarga" maxWidth="200.0" minWidth="150.0" text="Carga Exigida" />
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="20.0">
            <children>
                <Button onAction="#handleVoltar" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2; -fx-cursor: hand;" text="← Voltar">
                    <font>
                        <Font name="Monospaced Bold" size="13.0" />
                    </font>
                </Button>
                <Button onAction="#handlePlanejar" style="-fx-background-color: #eee; -fx-border-color: black; -fx-border-width: 3; -fx-cursor: hand;" text="Planejar Ementa →">
                    <font>
                        <Font name="Monospaced Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>