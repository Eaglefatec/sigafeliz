<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.MinhasDisciplinasController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <children>
        <VBox prefWidth="850.0" styleClass="card" spacing="15.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>

                <VBox spacing="10.0">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="MINHAS DISCIPLINAS" />
                    <Separator />
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Bem-vindo, " style="-fx-font-size: 14px;" />
                        <Label fx:id="lblNomeProfessor" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="..." />

                        <Label text="| Selecione o Semestre letivo:" style="-fx-font-size: 14px;">
                            <HBox.margin>
                                <Insets left="15.0" />
                            </HBox.margin>
                        </Label>
                        <ComboBox fx:id="comboSemestre" prefWidth="150.0" promptText="2026.1" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </HBox>

                <TableView fx:id="tabelaDisciplinas" prefHeight="250.0" styleClass="wireframe-table">
                    <columns>
                        <TableColumn fx:id="colNome" prefWidth="350.0" text="Disciplina" />
                        <TableColumn fx:id="colAulasSemana" prefWidth="200.0" text="Aulas/Semana" />
                        <TableColumn fx:id="colCarga" prefWidth="150.0" text="Carga Exigida" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colSelec" prefWidth="104.0" text="Selec." style="-fx-alignment: CENTER;" />
                    </columns>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </TableView>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleVoltar" styleClass="btn-secondary" text="← Voltar" prefHeight="40.0" prefWidth="120.0" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handlePlanejar" styleClass="btn-primary" text="Planejar Ementa →" prefHeight="40.0" prefWidth="160.0" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</VBox>