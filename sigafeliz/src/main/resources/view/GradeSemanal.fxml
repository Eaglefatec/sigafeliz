<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER_LEFT" prefHeight="600.0" prefWidth="800.0" spacing="15.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3; -fx-border-style: solid;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.ProfessoresListaController">
    <children>

        <Label prefWidth="759.0" style="-fx-border-color: black; -fx-border-width: 0 0 2 0; -fx-padding: 0 0 5 0;" text="GRADE DE AULAS SEMANAL DA DISCIPLINA">
            <font>
                <Font name="Monospaced Bold" size="18.0" />
            </font>
        </Label>

        <Label text="Defina a quantidade de aulas ministradas em cada dia da semana:">
            <font><Font name="Monospaced Regular" size="12.0" /></font>
        </Label>

        <GridPane maxWidth="1.7976931348623157E308" prefHeight="205.0" prefWidth="752.0" style="-fx-background-color: #f9f9f9; -fx-border-color: black; -fx-border-width: 2;">
            <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
            <RowConstraints minHeight="40.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="70.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="70.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <children>
                <!-- Cabeçalhos -->
                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: #eee; -fx-border-color: black; -fx-border-width: 1 1 1 1;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <padding><Insets bottom="15" left="10" right="10" top="15" /></padding>
                    <Label style="-fx-font-weight: BOLD;" text="SEG" />
                </HBox>
                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: #eee; -fx-border-color: black; -fx-border-width: 1 1 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <padding><Insets bottom="15" left="10" right="10" top="15" /></padding>
                    <Label style="-fx-font-weight: BOLD;" text="TER" />
                </HBox>
                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: #eee; -fx-border-color: black; -fx-border-width: 1 1 1 0;" GridPane.columnIndex="3" GridPane.rowIndex="1">
                    <padding><Insets bottom="15" left="10" right="10" top="15" /></padding>
                    <Label style="-fx-font-weight: BOLD;" text="QUA" />
                </HBox>
                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: #eee; -fx-border-color: black; -fx-border-width: 1 1 1 0;" GridPane.columnIndex="4" GridPane.rowIndex="1">
                    <padding><Insets bottom="15" left="10" right="10" top="15" /></padding>
                    <Label style="-fx-font-weight: BOLD;" text="QUI" />
                </HBox>
                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: #eee; -fx-border-color: black; -fx-border-width: 1 1 1 0;" GridPane.columnIndex="5" GridPane.rowIndex="1">
                    <padding><Insets bottom="15" left="10" right="10" top="15" /></padding>
                    <Label style="-fx-font-weight: BOLD;" text="SEX" />
                </HBox>

                <!-- Spinners -->
                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-border-color: black; -fx-border-width: 0 1 1 1;" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <padding><Insets bottom="15" left="10" right="10" top="15" /></padding>
                    <Spinner fx:id="spnSeg" prefWidth="80" style="-fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;" />
                </HBox>
                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-border-color: black; -fx-border-width: 0 1 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="2">
                    <padding><Insets bottom="15" left="10" right="10" top="15" /></padding>
                    <Spinner fx:id="spnTer" prefWidth="80" style="-fx-border-color: black; -fx-border-width: 1; -fx-background-radius: 3; -fx-border-radius: 3;" />
                </HBox>
                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-border-color: black; -fx-border-width: 0 1 1 0;" GridPane.columnIndex="3" GridPane.rowIndex="2">
                    <padding><Insets bottom="15" left="10" right="10" top="15" /></padding>
                    <Spinner fx:id="spnQua" prefWidth="80" style="-fx-border-color: black; -fx-border-width: 1; -fx-background-radius: 3; -fx-border-radius: 3;" />
                </HBox>
                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-border-color: black; -fx-border-width: 0 1 1 0;" GridPane.columnIndex="4" GridPane.rowIndex="2">
                    <padding><Insets bottom="15" left="10" right="10" top="15" /></padding>
                    <Spinner fx:id="spnQui" prefWidth="80" style="-fx-border-color: black; -fx-border-width: 1; -fx-background-radius: 3; -fx-border-radius: 3;" />
                </HBox>
                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-border-width: 0 1 1 0; -fx-border-color: black;" GridPane.columnIndex="5" GridPane.rowIndex="2">
                    <padding><Insets bottom="15" left="10" right="10" top="15" /></padding>
                    <Spinner fx:id="spnSex" prefWidth="80" style="-fx-border-color: black; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;" />
                </HBox>
            </children>
        </GridPane>

        <HBox maxWidth="1.7976931348623157E308" style="-fx-border-color: black; -fx-border-width: 2 0 0 0; -fx-border-style: dashed;">
            <padding><Insets top="10.0" /></padding>
        </HBox>

        <HBox alignment="CENTER_LEFT">
            <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltarParaHome" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3;" text="←  Salvar / Voltar">
                <font>
                    <Font name="Monospaced Bold" size="14.0" />
                </font>
            </Button>
        </HBox>

    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
