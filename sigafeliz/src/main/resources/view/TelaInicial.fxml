<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="40.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sigafeliz.controller.TelaInicialController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <VBox alignment="CENTER" spacing="10.0">
        <Label text="BEM-VINDO" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
        <Label text="Selecione o seu perfil de acesso para iniciar" style="-fx-font-size: 16px; -fx-text-fill: #666666;" />
    </VBox>

    <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0" styleClass="card">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <Button fx:id="btnProfessor" maxWidth="1.7976931348623157E308" prefHeight="50.0" onAction="#handleProfessorPath"
                styleClass="btn-primary" text="Sou Professor" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

        <Button fx:id="btnCoordinator" maxWidth="1.7976931348623157E308" prefHeight="50.0" onAction="#handleCoordinatorPath"
                styleClass="btn-secondary" text="Sou Coordenador" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    </VBox>

</VBox>