<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<BorderPane prefHeight="650" prefWidth="950"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.CoordenadorListaDisciplinasControllerEX">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <top>
        <VBox spacing="10">
            <padding>
                <Insets bottom="15" left="25" right="25" top="25" />
            </padding>
            <Label fx:id="lblTituloGeral" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="LISTA DE DISCIPLINAS" />
            <Separator />
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets left="25" right="25" />
            </padding>

            <TableView fx:id="tabelaDisciplinas" styleClass="wireframe-table" prefHeight="250.0" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colCurso" text="Curso (Turma)" prefWidth="250.0" />
                    <TableColumn fx:id="colNome" text="Disciplina" prefWidth="350.0" />
                    <TableColumn fx:id="colCarga" text="Carga Horária" prefWidth="120.0" minWidth="120.0" maxWidth="150.0" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colAcoesGrade" text="Grade" prefWidth="80.0" minWidth="80.0" maxWidth="100.0" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colAcoesSelec" text="Selec." prefWidth="60.0" minWidth="60.0" maxWidth="80.0" style="-fx-alignment: CENTER;" />
                </columns>
            </TableView>

            <GridPane styleClass="card" hgap="15" vgap="10">
                <padding>
                    <Insets bottom="15" left="15" right="15" top="15" />
                </padding>
                <columnConstraints>
                    <ColumnConstraints percentWidth="40" />
                    <ColumnConstraints percentWidth="40" />
                    <ColumnConstraints percentWidth="20" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="40.0" />
                </rowConstraints>

                <HBox alignment="CENTER" GridPane.columnIndex="0">
                    <TextField fx:id="txtCurso" promptText="Curso (Turma)" HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox alignment="CENTER" GridPane.columnIndex="1">
                    <TextField fx:id="txtDisciplina" promptText="Nome da Disciplina" HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox alignment="CENTER" GridPane.columnIndex="2">
                    <ComboBox fx:id="comboCarga" maxWidth="Infinity" promptText="Carga Horária" HBox.hgrow="ALWAYS" />
                </HBox>
            </GridPane>

            <HBox alignment="CENTER" spacing="20.0">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <Button fx:id="btnSalvar" onAction="#salvarDisciplina" prefHeight="40.0" prefWidth="120.0"
                        styleClass="btn-primary" text="Salvar" />
                <Button fx:id="btnExcluir" onAction="#excluirDisciplina" prefHeight="40.0" prefWidth="120.0"
                        styleClass="btn-danger" text="Excluir" />
            </HBox>

            <Separator>
                <VBox.margin>
                    <Insets top="15" />
                </VBox.margin>
            </Separator>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10">
            <padding>
                <Insets bottom="30" left="25" right="25" top="10" />
            </padding>
            <Button onAction="#voltar" prefHeight="45.0" prefWidth="120.0" styleClass="btn-secondary" text="← Voltar" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#avancar" prefHeight="45.0" prefWidth="120.0" styleClass="btn-primary" text="Avançar →" />
        </HBox>
    </bottom>
</BorderPane>