<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650" prefWidth="950" style="-fx-border-color: black; -fx-border-width: 3; -fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.CoordenadorListaDisciplinasControllerEX">

    <!-- TOPO -->
    <top>
        <VBox spacing="10">
            <padding>
                <Insets bottom="15" left="25" right="25" top="25" />
            </padding>
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Monospaced';" text="LISTA DE DISCIPLINAS" />
            <Separator style="-fx-background-color: black; -fx-pref-height: 2;" />
        </VBox>
    </top>

    <!-- CENTRO -->
    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets left="25" right="25" />
            </padding>

            <!-- TABELA DE EXIBIÇÃO (MANTÉM AS 5 COLUNAS PARA OS DADOS EXISTENTES) -->
            <GridPane gridLinesVisible="true" style="-fx-border-color: black; -fx-border-width: 2;">
                <columnConstraints>
                    <ColumnConstraints percentWidth="35" />
                    <ColumnConstraints percentWidth="35" />
                    <ColumnConstraints percentWidth="14" />
                    <ColumnConstraints percentWidth="8" />
                    <ColumnConstraints percentWidth="8" />
                </columnConstraints>

                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f0f0f0; -fx-padding: 8;">
                    <Label style="-fx-font-weight: bold;" text="Nome" />
                </HBox>
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f0f0f0; -fx-padding: 8;" GridPane.columnIndex="1">
                    <Label style="-fx-font-weight: bold;" text="Professor" />
                </HBox>
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f0f0f0; -fx-padding: 8;" GridPane.columnIndex="2">
                    <Label style="-fx-font-weight: bold;" text="Carga Horária" />
                </HBox>
                <HBox alignment="CENTER" style="-fx-background-color: #f0f0f0; -fx-padding: 8;" GridPane.columnIndex="3">
                    <Label style="-fx-font-weight: bold;" text="Grade" />
                </HBox>
                <HBox alignment="CENTER" style="-fx-background-color: #f0f0f0; -fx-padding: 8;" GridPane.columnIndex="4">
                    <Label style="-fx-font-weight: bold;" text="Selec." />
                </HBox>

                <!-- LINHA EXEMPLO -->
                <Label style="-fx-padding: 10;" text="Banco de Dados 1" GridPane.rowIndex="1" />
                <Label style="-fx-padding: 10;" text="Prof. Carlos Silva" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label style="-fx-padding: 10;" text="80" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <HBox alignment="CENTER" GridPane.columnIndex="3" GridPane.rowIndex="1">
                    <Button onAction="#abrirEditarGrade" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2; -fx-font-weight: bold;" text="Aulas" />
                </HBox>
                <HBox alignment="CENTER" GridPane.columnIndex="4" GridPane.rowIndex="1">
                    <RadioButton selected="true" />
                </HBox>
                <rowConstraints>
                    <RowConstraints minHeight="40.0" />
                    <RowConstraints minHeight="50.0" />
                </rowConstraints>
            </GridPane>

            <!-- LINHA DE EDIÇÃO (AGORA COM APENAS 3 COLUNAS DISTRIBUÍDAS) -->
            <GridPane gridLinesVisible="true" style="-fx-border-color: black; -fx-border-width: 2; -fx-background-color: #eeeeee;">
                <columnConstraints>
                    <ColumnConstraints percentWidth="40" /> <!-- Disciplina maior -->
                    <ColumnConstraints percentWidth="40" /> <!-- Professor maior -->
                    <ColumnConstraints percentWidth="20" /> <!-- Carga Horária ocupa o restante -->
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="60.0" />
                </rowConstraints>

                <HBox alignment="CENTER" style="-fx-padding: 5;">
                    <TextField fx:id="txtDisciplina" promptText="Nome da Disciplina" style="-fx-border-color: black; -fx-border-width: 2;" HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox alignment="CENTER" style="-fx-padding: 5;" GridPane.columnIndex="1">
                    <ComboBox fx:id="cbProfessor" maxWidth="Infinity" promptText="Selecione o Professor" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2;" HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox alignment="CENTER" style="-fx-padding: 5;" GridPane.columnIndex="2">
                    <ComboBox fx:id="comboCarga" maxWidth="Infinity" promptText="Carga Horária" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2;" HBox.hgrow="ALWAYS" />
                </HBox>
            </GridPane>

            <!-- BOTÕES CRUD CENTRALIZADOS -->
            <HBox alignment="CENTER" spacing="20.0">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <Button fx:id="btnSalvar" onAction="#salvarDisciplina" prefHeight="40.0" prefWidth="120.0"
                        style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 3; -fx-cursor: hand;" text="Salvar">
                    <font>
                        <Font name="Monospaced Bold" size="14.0" />
                    </font>
                </Button>
                <Button fx:id="btnExcluir" onAction="#excluirDisciplina" prefHeight="40.0" prefWidth="120.0"
                        style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3; -fx-cursor: hand;" text="Excluir">
                    <font>
                        <Font name="Monospaced Bold" size="14.0" />
                    </font>
                </Button>
            </HBox>

            <Separator style="-fx-border-color: black; -fx-border-style: dashed; -fx-border-width: 2 0 0 0; -fx-background-color: transparent;">
                <VBox.margin>
                    <Insets top="15" />
                </VBox.margin>
            </Separator>
        </VBox>
    </center>

    <!-- RODAPÉ -->
    <bottom>
        <HBox alignment="CENTER" spacing="10">
            <padding>
                <Insets bottom="30" left="25" right="25" top="10" />
            </padding>
            <Button onAction="#voltar" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3; -fx-font-weight: bold;" text="← Voltar" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#avancar" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3; -fx-font-weight: bold;" text="Avançar →" />
        </HBox>
    </bottom>
</BorderPane>