<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.exemplo.controller.ListaDisciplinasController"
            prefWidth="900" prefHeight="500"
            style="-fx-border-color: black; -fx-border-width: 2;">

    <!-- TOPO -->
    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="LISTA DE DISCIPLINAS"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <Separator/>
        </VBox>
    </top>

    <!-- CENTRO -->
    <center>
        <VBox spacing="5">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <GridPane gridLinesVisible="true">

                <columnConstraints>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="15"/>
                    <ColumnConstraints percentWidth="15"/>
                    <ColumnConstraints percentWidth="10"/>
                </columnConstraints>

                <!-- CABEÇALHO -->
                <Label text="Nome" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label text="Professor" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Carga Horária" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <Label text="Grade" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                <Label text="Selec." GridPane.rowIndex="0" GridPane.columnIndex="4"/>

                <!-- LINHA INSERÇÃO -->
                <TextField fx:id="txtDisciplina"
                           promptText="Disciplina"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>

                <ComboBox fx:id="cbProfessor"
                          promptText="Selecione o professor"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <ComboBox fx:id="cbCargaHoraria"
                          GridPane.rowIndex="3" GridPane.columnIndex="2"/>

                <Button text="Salvar"
                        fx:id="btnSalvar"
                        onAction="#salvarDisciplina"
                        GridPane.rowIndex="3" GridPane.columnIndex="4"/>

            </GridPane>

            <Button text="+" prefWidth="860"/>
            <Separator/>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button text="← Voltar"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Avançar →"/>
        </HBox>
    </bottom>

</BorderPane>