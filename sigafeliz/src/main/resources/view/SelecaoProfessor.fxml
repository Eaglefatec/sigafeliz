<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="20.0"
      style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sigafeliz.controller.SelecaoProfessorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <VBox alignment="CENTER" spacing="5.0">
        <Label text="IDENTIFICAÇÃO DOCENTE">
            <font>
                <Font name="Monospaced Bold" size="20.0"/>
            </font>
        </Label>
        <Label text="Selecione seu perfil cadastrado pela coordenação:">
            <font>
                <Font name="Monospaced Regular" size="13.0"/>
            </font>
        </Label>
    </VBox>

    <VBox alignment="CENTER" maxWidth="450.0" spacing="20.0"
          style="-fx-border-color: black; -fx-border-width: 2; -fx-padding: 40;">
        <Label text="Nome do Professor:">
            <font>
                <Font name="Monospaced Bold" size="14.0"/>
            </font>
        </Label>
        <ComboBox fx:id="comboProfessores" maxWidth="1.7976931348623157E308" promptText="-- Selecione --"
                  style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2; -fx-font-family: 'Monospaced';"/>
        <Button fx:id="btnAcessar" onAction="#handleAcessar"
                style="-fx-background-color: #eee; -fx-border-color: black; -fx-border-width: 3; -fx-cursor: hand;"
                text="Acessar Minhas Grades">
            <font>
                <Font name="Monospaced Bold" size="14.0"/>
            </font>
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
            </padding>
        </Button>
    </VBox>

    <HBox alignment="BOTTOM_LEFT" VBox.vgrow="ALWAYS">
        <Button onAction="#handleVoltar"
                style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2; -fx-cursor: hand;"
                text="← Voltar">
            <font>
                <Font name="Monospaced Bold" size="12.0"/>
            </font>
        </Button>
    </HBox>
</VBox>