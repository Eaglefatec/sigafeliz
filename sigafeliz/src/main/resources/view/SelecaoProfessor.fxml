<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="30.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sigafeliz.controller.SelecaoProfessorController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <VBox alignment="CENTER" spacing="10.0">
        <Label text="IDENTIFICAÇÃO DOCENTE" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Label text="Selecione seu perfil cadastrado pela coordenação:" style="-fx-font-size: 15px; -fx-text-fill: #555555;"/>
    </VBox>

    <VBox alignment="CENTER" maxWidth="450.0" spacing="25.0" styleClass="card">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <Label text="Nome do Professor:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <ComboBox fx:id="comboProfessores" maxWidth="1.7976931348623157E308" prefHeight="35.0" promptText="-- Selecione --" />

        <Button fx:id="btnAcessar" onAction="#handleAcessar" styleClass="btn-primary" text="Acessar Minhas Grades" prefHeight="45.0" maxWidth="1.7976931348623157E308" />
    </VBox>

    <HBox alignment="BOTTOM_LEFT" VBox.vgrow="ALWAYS">
        <Button onAction="#handleVoltar" styleClass="btn-secondary" text="← Voltar" prefHeight="40.0" prefWidth="120.0" />
    </HBox>
</VBox>