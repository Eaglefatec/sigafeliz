<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.PlanejamentoEmentaController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <VBox spacing="10">
        <Label fx:id="lblTituloDisciplina" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="PLANEJAMENTO: DISCIPLINA" />
        <Separator />
    </VBox>

    <HBox spacing="15.0">
        <VBox style="-fx-background-color: #e3f2fd; -fx-border-color: #bbdefb; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;" HBox.hgrow="ALWAYS">
            <Label fx:id="lblMetaAulas" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Meta: 80 Aulas" />
            <Label fx:id="lblSomaNoBox" style="-fx-font-size: 14px;" text="Dias letivos regulares mapeados: --" />
        </VBox>
        <VBox style="-fx-background-color: #fff3cd; -fx-border-color: #ffeeba; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="⚠️ Déficit identificado!" />
            <Label style="-fx-font-size: 14px;" text="O sistema ativará automaticamente sábados letivos." />
        </VBox>
    </HBox>

    <VBox fx:id="boxSprintError" managed="false" style="-fx-background-color: #f8d7da; -fx-border-color: #f5c6cb; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 10;" visible="false">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #721c24; -fx-font-size: 14px;" text="❌ Conflito de Avaliação!" />
        <Label style="-fx-text-fill: #721c24; -fx-font-size: 14px;" text="A aula caiu em zona restrita de Sprint. Ajuste a ordem ou carga." />
    </VBox>

    <HBox alignment="BOTTOM_LEFT" spacing="15.0">
        <Label text="Ementa de Temas" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblSomaAtualBarra" style="-fx-border-color: #cccccc; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-color: white; -fx-background-radius: 4; -fx-padding: 6 12 6 12; -fx-font-size: 13px; -fx-font-weight: bold;" text="Soma Atual Mín: 0 | Máx: 0" />
        <Button onAction="#handleExportar" styleClass="btn-secondary" text="📥 Exportar .XLSX" />
    </HBox>

    <TableView fx:id="tabelaTemas" styleClass="wireframe-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colOrdem" maxWidth="50.0" minWidth="50.0" text="Ord." style="-fx-alignment: CENTER;" />

            <TableColumn fx:id="colTitulo" text="Tema da Aula" style="-fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 10;" />

            <TableColumn fx:id="colMin" maxWidth="70.0" minWidth="70.0" text="Mín" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colMax" maxWidth="70.0" minWidth="70.0" text="Máx" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colPrioridade" maxWidth="110.0" minWidth="110.0" text="Prioridade" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colProva" maxWidth="60.0" minWidth="60.0" text="Prova?" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colAcoes" maxWidth="250.0" minWidth="250.0" text="Ações" style="-fx-alignment: CENTER;" />
        </columns>
    </TableView>

    <Button maxWidth="1.7976931348623157E308" onAction="#handleAdicionarTema" styleClass="btn-secondary" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 4 0;" text="+" />

    <Label style="-fx-font-size: 13px; -fx-text-fill: #666666;" text="* O sistema aloca primeiro a carga Mínima de todos os temas. As vagas restantes são preenchidas pela Prioridade até o limite Máximo." />

    <Separator />

    <HBox alignment="CENTER" spacing="15.0">
        <Button onAction="#handleVoltar" styleClass="btn-secondary" prefHeight="40.0" prefWidth="120.0" text="← Voltar" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleFinalizar" styleClass="btn-primary" prefHeight="40.0" prefWidth="180.0" text="Finalizar Planejamento" />
    </HBox>

</VBox>