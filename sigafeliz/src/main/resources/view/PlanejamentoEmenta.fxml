<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="15.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.PlanejamentoEmentaController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="lblTituloDisciplina" text="PLANEJAMENTO: DISCIPLINA">
        <font>
            <Font name="Monospaced Bold" size="18.0" />
        </font>
    </Label>

    <HBox spacing="15.0">
        <VBox style="-fx-border-color: black; -fx-border-width: 2; -fx-padding: 10; -fx-background-color: #d1ecf1;" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="lblMetaAulas" style="-fx-font-weight: bold; -fx-font-family: 'Monospaced';" text="Meta: 80 Aulas" />
                <Label fx:id="lblSomaNoBox" style="-fx-font-family: 'Monospaced';" text="Soma Cadastrada Mín: 0 | Máx: 0" />
            </children>
        </VBox>
        <VBox style="-fx-border-color: black; -fx-border-width: 2; -fx-padding: 10; -fx-background-color: #fff3cd;" HBox.hgrow="ALWAYS">
            <children>
                <Label style="-fx-font-weight: bold; -fx-font-family: 'Monospaced';" text="[!] Déficit identificado!" />
                <Label style="-fx-font-family: 'Monospaced';" text="Ativação automática de sábados para atingir a meta." />
            </children>
        </VBox>
    </HBox>

    <VBox fx:id="boxSprintError" managed="false" style="-fx-background-color: #f8d7da; -fx-border-color: #f5c6cb; -fx-border-width: 2; -fx-padding: 10;" visible="false">
        <children>
            <Label style="-fx-font-weight: bold; -fx-text-fill: #721c24; -fx-font-family: 'Monospaced';" text="[X] Conflito de Avaliação!" />
            <Label style="-fx-text-fill: #721c24; -fx-font-family: 'Monospaced';" text="A aula caiu em zona restrita de Sprint. Ajuste a ordem ou carga." />
        </children>
    </VBox>

    <HBox alignment="BOTTOM_LEFT" spacing="15.0">
        <children>
            <Label text="Ementa de Temas">
                <font>
                    <Font name="Monospaced Bold" size="14.0" />
                </font>
            </Label>
            <HBox HBox.hgrow="ALWAYS" />
            <Label fx:id="lblSomaAtualBarra" style="-fx-border-color: black; -fx-padding: 2 5 2 5; -fx-font-family: 'Monospaced'; -fx-font-size: 12px;" text="Soma Atual Mín: 0 | Máx: 0" />
            <Button onAction="#handleExportar" style="-fx-background-color: #e0e0e0; -fx-border-color: black; -fx-border-width: 2; -fx-cursor: hand; -fx-font-family: 'Monospaced';" text="📥 Exportar .XLSX" />
        </children>
    </HBox>

    <TableView fx:id="tabelaTemas" styleClass="wireframe-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colOrdem" maxWidth="50.0" minWidth="50.0" text="Ord." />
            <TableColumn fx:id="colTitulo" text="Tema da Aula" />
            <TableColumn fx:id="colMin" maxWidth="60.0" minWidth="60.0" text="Mín" />
            <TableColumn fx:id="colMax" maxWidth="60.0" minWidth="60.0" text="Máx" />
            <TableColumn fx:id="colPrioridade" maxWidth="100.0" minWidth="100.0" text="Prioridade" />
            <TableColumn fx:id="colProva" maxWidth="60.0" minWidth="60.0" text="Prova?" />
            <TableColumn fx:id="colAcoes" maxWidth="60.0" minWidth="60.0" text="Ações" />
        </columns>
    </TableView>

    <HBox fx:id="boxInlineAdd" managed="false" spacing="5.0" style="-fx-background-color: #f0f0f0; -fx-padding: 5; -fx-border-color: black; -fx-border-width: 1;" visible="false">
        <children>
            <TextField fx:id="txtOrd" disable="true" prefWidth="50.0" style="-fx-font-family: 'Monospaced';" />
            <TextField fx:id="txtTema" promptText="Nome do tema..." style="-fx-font-family: 'Monospaced';" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtMin" prefWidth="60.0" promptText="Min" style="-fx-font-family: 'Monospaced';" />
            <TextField fx:id="txtMax" prefWidth="60.0" promptText="Max" style="-fx-font-family: 'Monospaced';" />
            <ComboBox fx:id="cbPrioridade" prefWidth="100.0" style="-fx-font-family: 'Monospaced';" />
            <CheckBox fx:id="chkProva" alignment="CENTER" prefWidth="60.0" />
            <Button onAction="#handleSalvarInline" prefWidth="60.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2; -fx-cursor: hand; -fx-font-family: 'Monospaced';" text="Salvar" />
        </children>
    </HBox>

    <Button maxWidth="1.7976931348623157E308" onAction="#handleExibirInlineAdd" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2; -fx-font-size: 16px; -fx-cursor: hand;" text="+" />

    <Label style="-fx-font-family: 'Monospaced'; -fx-font-size: 12px;" text="* O sistema aloca primeiro a carga Mínima de todos os temas. As vagas restantes são preenchidas pela Prioridade até o limite Máximo." />

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <children>
            <Button onAction="#handleVoltar" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2; -fx-cursor: hand;" text="← Voltar">
                <font>
                    <Font name="Monospaced Bold" size="13.0" />
                </font>
            </Button>
            <Button onAction="#handleFinalizar" style="-fx-background-color: #eee; -fx-border-color: black; -fx-border-width: 3; -fx-cursor: hand;" text="Finalizar Planejamento">
                <font>
                    <Font name="Monospaced Bold" size="13.0" />
                </font>
            </Button>
        </children>
    </HBox>
</VBox>