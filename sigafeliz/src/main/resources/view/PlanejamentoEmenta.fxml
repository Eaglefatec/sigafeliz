<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="15.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigafeliz.controller.PlanejamentoEmentaController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="lblTituloDisciplina" maxWidth="1.7976931348623157E308" style="-fx-border-color: transparent transparent black transparent; -fx-border-width: 0 0 3 0; -fx-padding: 0 0 5 0;" text="PLANEJAMENTO: DISCIPLINA">
        <font><Font name="Monospaced Bold" size="18.0" /></font>
    </Label>

    <HBox spacing="15.0">
        <VBox style="-fx-border-color: black; -fx-border-width: 2; -fx-padding: 10; -fx-background-color: #d1ecf1;" HBox.hgrow="ALWAYS">
            <Label fx:id="lblMetaAulas" style="-fx-font-weight: bold; -fx-font-family: 'Monospaced';" text="Meta: 80 Aulas" />
            <Label fx:id="lblSomaNoBox" style="-fx-font-family: 'Monospaced';" text="Dias letivos regulares mapeados: --" />
        </VBox>
        <VBox style="-fx-border-color: #ffeeba; -fx-border-width: 2; -fx-padding: 10; -fx-background-color: #fff3cd;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-weight: bold; -fx-font-family: 'Monospaced';" text="⚠️ Déficit identificado!" />
            <Label style="-fx-font-family: 'Monospaced';" text="O sistema ativará automaticamente sábados letivos." />
        </VBox>
    </HBox>

    <VBox fx:id="boxSprintError" managed="false" style="-fx-background-color: #f8d7da; -fx-border-color: #f5c6cb; -fx-border-width: 2; -fx-padding: 10;" visible="false">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #721c24; -fx-font-family: 'Monospaced';" text="❌ Conflito de Avaliação!" />
        <Label style="-fx-text-fill: #721c24; -fx-font-family: 'Monospaced';" text="A aula caiu em zona restrita de Sprint. Ajuste a ordem ou carga." />
    </VBox>

    <HBox alignment="BOTTOM_LEFT" spacing="15.0">
        <Label text="Ementa de Temas" style="-fx-font-family: 'Monospaced'; -fx-font-weight: bold; -fx-font-size: 16px;" />
        <HBox HBox.hgrow="ALWAYS" />
        <Label fx:id="lblSomaAtualBarra" style="-fx-border-color: black; -fx-border-width: 1; -fx-padding: 4 8 4 8; -fx-font-family: 'Monospaced'; -fx-font-size: 12px; -fx-background-color: white;" text="Soma Atual Mín: 0 | Máx: 0" />
        <Button onAction="#handleValidar" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3; -fx-cursor: hand; -fx-font-family: 'Monospaced'; -fx-font-weight: bold;" text="Validar Distribuição" />
        <Button onAction="#handleExportar" style="-fx-background-color: #e0e0e0; -fx-border-color: black; -fx-border-width: 3; -fx-cursor: hand; -fx-font-family: 'Monospaced'; -fx-font-weight: bold;" text="📥 Exportar .XLSX" />
    </HBox>

    <TableView fx:id="tabelaTemas" styleClass="wireframe-table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colOrdem" maxWidth="50.0" minWidth="50.0" text="Ord." style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colTitulo" text="Tema da Aula" />
            <TableColumn fx:id="colMin" maxWidth="70.0" minWidth="70.0" text="Mín" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colMax" maxWidth="70.0" minWidth="70.0" text="Máx" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colPrioridade" maxWidth="110.0" minWidth="110.0" text="Prioridade" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colProva" maxWidth="60.0" minWidth="60.0" text="Prova?" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colAcoes" maxWidth="140.0" minWidth="140.0" text="Ações" style="-fx-alignment: CENTER;" />
        </columns>
    </TableView>

    <Button maxWidth="1.7976931348623157E308" onAction="#handleAdicionarTema" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;" text="+" />

    <Label style="-fx-font-family: 'Monospaced'; -fx-font-size: 12px;" text="* O sistema aloca primeiro a carga Mínima de todos os temas. As vagas restantes são preenchidas pela Prioridade até o limite Máximo." />

    <HBox alignment="CENTER" spacing="15.0" style="-fx-border-color: black transparent transparent transparent; -fx-border-width: 2 0 0 0; -fx-border-style: dashed; -fx-padding: 15 0 0 0;">
        <Button onAction="#handleVoltar" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 3; -fx-cursor: hand; -fx-font-family: 'Monospaced'; -fx-font-weight: bold;" text="← Voltar" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleFinalizar" style="-fx-background-color: #eee; -fx-border-color: black; -fx-border-width: 3; -fx-cursor: hand; -fx-font-family: 'Monospaced'; -fx-font-weight: bold;" text="Finalizar Planejamento" />
    </HBox>
</VBox>